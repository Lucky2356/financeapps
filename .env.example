# The app runs entirely on the device — no server, no database, no accounts.
# Nothing here is required to build or run it: the two variables below only
# switch build modes and the npm scripts already set them.

# Static export for the Tauri shells (Windows and Android). Set by build:static.
NEXT_OUTPUT=""

# Market data source: mock | moex
NEXT_PUBLIC_MARKET_DATA="moex"
