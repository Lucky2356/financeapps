<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Камера — только для чтения картинки связки. Плагин сканера объявляет
         это разрешение и сам, но манифест читают люди: оставлять единственный
         повод просить камеру невидимым в складе неправильно. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- И тут же — что камера НЕ обязательна. Без этой строки установщики
         считают её требованием и прячут приложение от устройств без камеры, а
         оно работает на них полностью: код связки набирают руками. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Установка обновления прямо из приложения (InstallerPlugin): без этого
         разрешения Android не откроет экран установки скачанного APK. Первый
         раз система сама спросит, можно ли этому приложению ставить файлы. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Резервной копии Android здесь нет — нарочно.

         Android сам складывает данные приложений в копию Google и при новой
         установке молча кладёт их обратно. В 2.0.0 так и вышло: человек удалил
         приложение, поставил заново — и получил старые записи и старое
         подключение к серверу, хотя всё очищал. Хуже того, у данных без пароля
         ключ лежит рядом с ними, и в копию уехал бы вместе с ними.

         Способы перенести данные у приложения свои и явные: синхронизация по
         QR-коду и файл резервной копии. Удалил приложение — значит, удалил. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.financial_assistant"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- QR-код связки открывается обычной камерой телефона: ссылка
                 financeapps://pair… приводит сюда, а InstallerPlugin отдаёт её
                 странице. Без этого код приходилось снимать из самого
                 приложения, кнопкой «Сканировать». -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="financeapps" android:host="pair" />
            </intent-filter>
            <!-- Ярлыки на значке: «Расход», «Доход», «Сканировать чек». -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
