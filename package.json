{
  "name": "financial-assistant-mvp",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "cross-env NEXT_PUBLIC_MARKET_DATA=moex next dev",
    "build": "next build",
    "build:static": "cross-env NEXT_PUBLIC_MARKET_DATA=moex NEXT_OUTPUT=export next build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "test:server": "node --experimental-strip-types --test server/test/*.test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.reporter=text",
    "test:smoke": "vitest run tests/user-journey.test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-with-rust-path.mjs dev",
    "tauri:build": "node scripts/tauri-with-rust-path.mjs build",
    "android:init": "node scripts/tauri-android.mjs init",
    "android:dev": "node scripts/tauri-android.mjs dev",
    "android:build": "node scripts/tauri-android.mjs build --apk",
    "android:build:debug": "node scripts/tauri-android.mjs build --debug --apk",
    "desktop:icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-tauri-icons.ps1",
    "desktop:preflight": "node scripts/desktop-preflight.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{js,jsx,mjs,cjs,json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.6",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.3",
    "openai": "^7.21.0",
    "papaparse": "^5.7.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.17.6",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.6.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.6",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
